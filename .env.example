# ===========================================
# Portal Supply Chain Dorel Peru - Variables de Entorno
# ===========================================
# Copiar este archivo como .env y completar con valores reales.
# NUNCA subir .env a Git.

# --- App Login ---
APP_USER=queryplanificacion
APP_PASSWORD=tu_password_aqui

# --- Snowflake (Peru) ---
SNOWFLAKE_USER=tu_usuario_servicio@dorel.com
SNOWFLAKE_PASSWORD=tu_password_snowflake
SNOWFLAKE_ACCOUNT=DOREL-DJ_PER
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=PUBLIC
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# --- Autenticador Snowflake (opcional) ---
# Dejar comentado para cuenta de servicio con password (produccion).
# Descomentar para SSO con navegador (solo desarrollo local).
# SNOWFLAKE_AUTHENTICATOR=externalbrowser

# --- Email Alertas (Gmail recomendado) ---
OUTLOOK_EMAIL=alertas.dorel.pe@gmail.com
OUTLOOK_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
# Lista de destinatarios separados por coma
ALERT_RECIPIENTS=usuario@dorel.com

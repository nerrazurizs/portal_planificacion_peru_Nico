.env
.env.local
users.json
.snowflake_credentials*
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.xlsx
*.csv
!.env.example
.DS_Store
pandasai.log
exports/

# Claude dev context
.claude/

# Node / Frontend
node_modules/
frontend/node_modules/

# Allow persisted input files for projection
!data/inputs/forecast.xlsx
!data/inputs/precios.xlsx
!data/inputs/metadata.json
# Nota: compra.csv se dejó FUERA a propósito (lo captura *.csv). Es data de trabajo
# que cambia seguido; versionarla infla los PRs y genera conflictos (rompió el PR #42).

# Flujo de Costos — archivos default compartidos (visibles para todos los usuarios)
!data/inputs/budget_default.xlsx
!data/inputs/factor_override.xlsx

# In-Out bound — maestra SKU con AREA/TAMANIO/TIPO_ALMACEN (default compartido)
!data/inputs/leyendas.xlsx

# Projection results cache (large files)
data/inputs/*.parquet
# Excepción: proy_result.parquet se necesita en GitHub Actions para alertas email
!data/inputs/proy_result.parquet

# Scenario comparison files (local per user)
data/inputs/scenarios/

# Forecast accuracy snapshots (user-uploaded data, persisted locally)
data/forecast_snapshots/*.parquet
data/forecast_snapshots/metadata.json

# Backend virtualenv
backend/.venv/

# Root virtualenv
venv/
